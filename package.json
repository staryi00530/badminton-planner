{
  "name": "badminton",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/run-tests.mjs run",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:watch": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^24.1.3",
    "playwright": "^1.61.0",
    "terser": "^5.48.0",
    "typescript": "^5.4.5",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
